# Copie para apps/api/.env para rodar a API fora do Docker (pnpm dev).
DATABASE_URL=postgresql://nobre:nobre@localhost:5432/nobre_crm
PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
# "Hoje" dos cálculos de domínio (YYYY-MM-DD). Remova para usar a data real.
REFERENCE_DATE=2026-10-15
# Recálculo periódico dos follow-ups (expressão cron). Padrão: a cada hora.
FOLLOWUP_CRON=0 * * * *
# Opcional: webhook (Slack/Teams/n8n) que recebe o resumo quando o job cria ações.
FOLLOWUP_WEBHOOK_URL=
LOG_LEVEL=info
NODE_ENV=development
